# ── Entornos virtuales ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Datos pesados (no versionar — descargar desde Kaggle) ──────────────────
data/raw/*
data/interim/*
data/processed/*
# Conservar la carpeta vacía para que el pipeline no falle al clonar
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ── Encoders serializados (generados por NB-06, no son input del repo) ─────
encoders/*
!encoders/.gitkeep

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ── Sistema operativo ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
